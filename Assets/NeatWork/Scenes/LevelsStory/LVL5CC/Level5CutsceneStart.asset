  m_Script: {fileID: 11500000, guid: ae544f6af7851b7448240f9d768658d0, type: 3}
  m_Name: Level5CutsceneStart
  m_EditorClassIdentifier: 
  lines:
  - characterName: 'Original Tribe Leader:'
    text: 'You look stronger.

      But strength without allegiance is chaos.'
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 21300000, guid: f8703fbdb47f9844282d8679cdc0be9f, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Player 1:'
    text: 'No.

      Strength without chains is freedom.'
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 21300000, guid: da130056469a1bb42b68127249aba7ae, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Leader:'
    text: You could have ruled beside me.
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 21300000, guid: f8703fbdb47f9844282d8679cdc0be9f, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Player 1 :'
    text: 'I would rather build something new

      than inherit something corrupt.'
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 21300000, guid: da130056469a1bb42b68127249aba7ae, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Girl (over comms):'
    text: "This isn\u2019t revenge anymore.\r\nIt\u2019s resolution.\r\nDrive with
      clarity."
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 21300000, guid: ed71d1e379718bd43abd89d3d8dfc24b, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  nextSceneName: Level 2
