%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ae544f6af7851b7448240f9d768658d0, type: 3}
  m_Name: Level5CutsceneEND
  m_EditorClassIdentifier: 
  lines:
  - characterName: 'Leader (Injured):'
    text: 'You have the chance to erase me.

      Finish what the desert started.'
    backgroundSprite: {fileID: 21300000, guid: bd0465c2c0b46764c96829a4a8ec8c13, type: 3}
    PlayerSprite: {fileID: 21300000, guid: f8703fbdb47f9844282d8679cdc0be9f, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Player 1 (calm):'
    text: "No.\r\nBecause I don\u2019t need your fall to validate my rise.\r\nYou
      abandoned me thinking I\u2019d disappear.\r\nInstead\u2026 I became independent."
    backgroundSprite: {fileID: 21300000, guid: bd0465c2c0b46764c96829a4a8ec8c13, type: 3}
    PlayerSprite: {fileID: 21300000, guid: da130056469a1bb42b68127249aba7ae, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Player 1 (to girl):'
    text: "They tried to define my worth.\r\nBut worth isn\u2019t granted by tribes.\r\nIt\u2019s
      forged in isolation."
    backgroundSprite: {fileID: 21300000, guid: bd0465c2c0b46764c96829a4a8ec8c13, type: 3}
    PlayerSprite: {fileID: 21300000, guid: da130056469a1bb42b68127249aba7ae, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Girl:'
    text: So where do we go now?
    backgroundSprite: {fileID: 21300000, guid: bd0465c2c0b46764c96829a4a8ec8c13, type: 3}
    PlayerSprite: {fileID: 21300000, guid: ed71d1e379718bd43abd89d3d8dfc24b, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Player 1 (looking at horizon):'
    text: "Forward.\r\nNot as someone seeking revenge\u2026\r\nBut as someone who
      understands his value."
    backgroundSprite: {fileID: 21300000, guid: bd0465c2c0b46764c96829a4a8ec8c13, type: 3}
    PlayerSprite: {fileID: 21300000, guid: da130056469a1bb42b68127249aba7ae, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  nextSceneName: Level 2
