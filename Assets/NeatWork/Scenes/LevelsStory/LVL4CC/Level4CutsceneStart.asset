--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ae544f6af7851b7448240f9d768658d0, type: 3}
  m_Name: Level4CutsceneStart
  m_EditorClassIdentifier: 
  lines:
  - characterName: 'Girl:'
    text: "This is the last barrier before your old tribe.\r\nAfter this race\u2026
      you confront your past directly."
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 21300000, guid: ed71d1e379718bd43abd89d3d8dfc24b, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Player 1:'
    text: "For weeks I thought I wanted to destroy them.\r\nBut now\u2026 I think
      I just want them to see me."
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 21300000, guid: da130056469a1bb42b68127249aba7ae, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Girl :'
    text: Seen as what?
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 21300000, guid: ed71d1e379718bd43abd89d3d8dfc24b, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Player 1 :'
    text: "As someone who didn\u2019t need them to become powerful."
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 21300000, guid: da130056469a1bb42b68127249aba7ae, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Girl:'
    text: "Then don\u2019t race like a victim seeking justice.\r\nRace like a leader
      claiming destiny."
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 21300000, guid: ed71d1e379718bd43abd89d3d8dfc24b, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  nextSceneName: Level 2
