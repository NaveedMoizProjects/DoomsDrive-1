  m_Script: {fileID: 11500000, guid: ae544f6af7851b7448240f9d768658d0, type: 3}
  m_Name: Level4CutsceneEND
  m_EditorClassIdentifier: 
  lines:
  - characterName: 'Defeated Opponent:'
    text: 'Your leader waits in the Black Dune Arena.

      He chose the battlefield
      himself.

      He thinks control guarantees victory.'
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 0}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Player 1:'
    text: "He still doesn\u2019t understand.\r\nControl isn\u2019t strength.\r\nAdaptation
      is."
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 21300000, guid: da130056469a1bb42b68127249aba7ae, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Girl (softly):'
    text: "No matter what happens next\u2026\r\nYou\u2019re not the abandoned warrior
      anymore.\r\nYou\u2019re the one others choose to follow."
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 21300000, guid: ed71d1e379718bd43abd89d3d8dfc24b, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  nextSceneName: Cutscene_level5_Start
