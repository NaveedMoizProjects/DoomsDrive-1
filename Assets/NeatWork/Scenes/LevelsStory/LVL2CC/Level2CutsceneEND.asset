  m_Script: {fileID: 11500000, guid: ae544f6af7851b7448240f9d768658d0, type: 3}
  m_Name: Level2CutsceneEND
  m_EditorClassIdentifier: 
  lines:
  - characterName: 'Defeated Tribe Member:'
    text: "Your old tribe\u2026 they speak of you like a warning.\r\nLike a mistake
      they had to erase."
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 0}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Player 1:'
    text: 'They erased the wrong thing.

      They erased their future.'
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 21300000, guid: da130056469a1bb42b68127249aba7ae, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Girl (serious):'
    text: "They\u2019re watching now.\r\nEvery victory you claim reshapes the balance
      between tribes.\r\nYou\u2019re not just fighting for yourself anymore."
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 21300000, guid: ed71d1e379718bd43abd89d3d8dfc24b, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Player 1 :'
    text: "Then maybe this was never about one man\u2019s revenge.\r\nMaybe it\u2019s
      about breaking a system that feeds on silence."
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 21300000, guid: da130056469a1bb42b68127249aba7ae, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  nextSceneName: Level 2
