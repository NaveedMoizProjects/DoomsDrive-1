--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ae544f6af7851b7448240f9d768658d0, type: 3}
  m_Name: LVL2Pending
  m_EditorClassIdentifier: 
  lines:
  - characterName: 'Defeated Racer:'
    text: "You don\u2019t drive like someone trying to win.\r\nYou drive like someone
      trying to escape something."
    backgroundSprite: {fileID: 21300000, guid: 552312490d38f3445b19a2081ae38208, type: 3}
    PlayerSprite: {fileID: 21300000, guid: 78649824bc5c689448b0d0185e7b4cfc, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Player 1:'
    text: "I\u2019m not escaping.\r\nI\u2019m chasing the version of myself they
      tried to bury."
    backgroundSprite: {fileID: 21300000, guid: 552312490d38f3445b19a2081ae38208, type: 3}
    PlayerSprite: {fileID: 21300000, guid: da130056469a1bb42b68127249aba7ae, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Girl (after crowd disperses):'
    text: "You didn\u2019t just win.\r\nYou proved you still believe you deserve
      to exist.\r\nThat\u2019s more important."
    backgroundSprite: {fileID: 21300000, guid: 552312490d38f3445b19a2081ae38208, type: 3}
    PlayerSprite: {fileID: 21300000, guid: ed71d1e379718bd43abd89d3d8dfc24b, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Player 1 (quiet):'
    text: "(For the first time since the betrayal\u2026\r\nI didn\u2019t feel abandoned.\r\nI
      felt\u2026 capable.)"
    backgroundSprite: {fileID: 21300000, guid: 552312490d38f3445b19a2081ae38208, type: 3}
    PlayerSprite: {fileID: 21300000, guid: da130056469a1bb42b68127249aba7ae, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  nextSceneName: Level 2
