  lines:
  - characterName: 'Rival Leader:'
    text: "You were cast out\u2026 yet you rise faster than anyone expected.\r\nDo
      you know why that terrifies your old tribe?"
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 0}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Player 1:'
    text: Because I survived.
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 21300000, guid: da130056469a1bb42b68127249aba7ae, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Rival Leader:'
    text: 'No.

      Because you evolved.'
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 0}
    typingSpeed: 0.1
    showTextBox: 1
  - characterName: 'Girl (after rival leaves):'
    text: "You\u2019re not the same person they betrayed.\r\nAnd that\u2019s your
      greatest weapon."
    backgroundSprite: {fileID: 21300000, guid: 0b9e74108f97b2a45b7b17122211c781, type: 3}
    PlayerSprite: {fileID: 21300000, guid: ed71d1e379718bd43abd89d3d8dfc24b, type: 3}
    typingSpeed: 0.1
    showTextBox: 1
  nextSceneName: Level 2
